<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agriculture.dao.CommentMapper">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.agriculture.model.po.Comment">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="post_id" property="postId" jdbcType="INTEGER"/>
        <result column="user_id" property="userId" jdbcType="INTEGER"/>
        <result column="content" property="content" jdbcType="LONGVARCHAR"/>
        <result column="parent_id" property="parentId" jdbcType="INTEGER"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 插入评论 -->
    <insert id="insert" parameterType="com.agriculture.model.po.Comment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            post_id, user_id, content,
            <if test="parentId != null">parent_id,</if>
            <!-- 不包含create_time，让数据库自动填充 -->
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{postId}, #{userId}, #{content},
            <if test="parentId != null">#{parentId},</if>
            <!-- 不包含create_time，让数据库自动填充 -->
        </trim>
    </insert>

    <!-- 批量插入 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO comment (post_id, user_id, content, parent_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.postId}, #{item.userId}, #{item.content}, #{item.parentId})
        </foreach>
    </insert>

    <!-- 根据ID删除 -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM comment WHERE id = #{id}
    </delete>

    <!-- 根据帖子ID删除 -->
    <delete id="deleteByPostId" parameterType="java.lang.Integer">
        DELETE FROM comment WHERE post_id = #{postId}
    </delete>

    <!-- 更新评论 -->
    <update id="update" parameterType="com.agriculture.model.po.Comment">
        UPDATE comment
        <set>
            <if test="postId != null">post_id = #{postId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="content != null">content = #{content},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            create_time =CURRENT_TIMESTAMP <!-- 强制设置为当前时间 -->
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据ID查询 -->
    <select id="selectById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM comment WHERE id = #{id}
    </select>

    <!-- 查询所有评论 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM comment
    </select>

    <!-- 根据帖子ID查询评论 -->
    <select id="selectByPostId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM comment WHERE post_id = #{postId}
    </select>

    <!-- 根据用户ID查询评论 -->
    <select id="selectByUserId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM comment WHERE user_id = #{userId}
    </select>

    <!-- 根据父评论ID查询回复 -->
    <select id="selectByParentId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM comment WHERE parent_id = #{parentId}
    </select>

    <!-- 查询帖子的顶级评论（无父评论的） -->
    <select id="selectTopLevelByPostId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM comment
        WHERE post_id = #{postId} AND parent_id IS NULL
    </select>

    <!-- 查询帖子的所有评论（包括回复） -->
    <select id="selectAllByPostId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM comment
        WHERE post_id = #{postId}
        ORDER BY create_time ASC
    </select>

    <!-- 复合条件查询 -->
    <select id="selectByCondition" parameterType="com.agriculture.model.po.Comment" resultMap="BaseResultMap">
        SELECT * FROM comment
        <where>
            <if test="postId != null">AND post_id = #{postId}</if>
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="parentId != null">AND parent_id = #{parentId}</if>
            <if test="content != null">AND content LIKE CONCAT('%', #{content}, '%')</if>
        </where>
        ORDER BY create_time ASC
    </select>

    <!-- 统计帖子评论数 -->
    <select id="countByPostId" parameterType="java.lang.Integer" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM comment WHERE post_id = #{postId}
    </select>

    <!-- 统计用户评论数 -->
    <select id="countByUserId" parameterType="java.lang.Integer" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM comment WHERE user_id = #{userId}
    </select>
</mapper>
