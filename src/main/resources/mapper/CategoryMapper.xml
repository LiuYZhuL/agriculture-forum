<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agriculture.dao.CategoryMapper">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.agriculture.model.po.Category">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 插入分类 -->
    <insert id="insertCategory" parameterType="com.agriculture.model.po.Category" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            name,
            <if test="description != null">description,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{name},
            <if test="description != null">#{description},</if>
        </trim>
    </insert>

    <!-- 批量插入 -->
    <insert id="batchInsertCategory" parameterType="java.util.List">
        INSERT INTO category (name, description)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.name}, #{item.description})
        </foreach>
    </insert>

    <!-- 根据ID删除 -->
    <delete id="deleteCategoryById" parameterType="java.lang.Integer">
        DELETE FROM category WHERE id = #{id}
    </delete>

    <!-- 更新分类 -->
    <update id="updateCategory" parameterType="com.agriculture.model.po.Category">
        UPDATE category
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据ID查询 -->
    <select id="selectCategoryById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM category WHERE id = #{id}
    </select>

    <!-- 查询所有分类 -->
    <select id="selectAllCategory" resultMap="BaseResultMap">
        SELECT * FROM category ORDER BY id ASC
    </select>

    <!-- 根据名称查询（精确匹配） -->
    <select id="selectCategoryByName" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT * FROM category WHERE name = #{name}
    </select>

    <!-- 根据名称模糊查询 -->
    <select id="searchCategoryByName" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT * FROM category WHERE name LIKE CONCAT('%', #{name}, '%')
    </select>

    <!-- 复合条件查询 -->
    <select id="selectCategoryByCondition" parameterType="com.agriculture.model.po.Category" resultMap="BaseResultMap">
        SELECT * FROM category
        <where>
            <if test="name != null">AND name LIKE CONCAT('%', #{name}, '%')</if>
            <if test="description != null">AND description LIKE CONCAT('%', #{description}, '%')</if>
        </where>
        ORDER BY id ASC
    </select>

    <!-- 统计分类总数 -->
    <select id="countCategory" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM category
    </select>

    <!-- 检查分类名称是否存在 -->
    <select id="existsCategory" resultType="java.lang.Boolean">
        SELECT COUNT(*) > 0 FROM category WHERE name = #{name} AND id != #{id}
    </select>
    <!-- 检查分类名称是否存在 -->
    <select id="existsCategoryByName" resultType="java.lang.Boolean">
        SELECT COUNT(*) > 0 FROM category WHERE name = #{name}
    </select>
</mapper>
