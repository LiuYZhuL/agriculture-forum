<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agriculture.dao.InteractionMapper">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.agriculture.model.po.Interaction">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="post_id" property="postId" jdbcType="INTEGER"/>
        <result column="user_id" property="userId" jdbcType="INTEGER"/>
        <result column="type" property="type" jdbcType="TINYINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 插入互动记录 -->
    <insert id="insert" parameterType="com.agriculture.model.po.Interaction" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO interaction
        <trim prefix="(" suffix=")" suffixOverrides=",">
            post_id, user_id, type,
            <if test="createTime != null">create_time,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{postId}, #{userId}, #{type},
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <!-- 批量插入 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO interaction (post_id, user_id, type, create_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.postId}, #{item.userId}, #{item.type}, #{item.createTime})
        </foreach>
    </insert>

    <!-- 根据ID删除 -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM interaction WHERE id = #{id}
    </delete>

    <!-- 根据复合条件删除 -->
    <delete id="deleteByCondition" parameterType="com.agriculture.model.po.Interaction">
        DELETE FROM interaction
        WHERE post_id = #{postId} AND user_id = #{userId} AND type = #{type}
    </delete>

    <!-- 更新互动记录 -->
    <update id="update" parameterType="com.agriculture.model.po.Interaction">
        UPDATE interaction
        <set>
            <if test="postId != null">post_id = #{postId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="type != null">type = #{type},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据ID查询 -->
    <select id="selectById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM interaction WHERE id = #{id}
    </select>

    <!-- 查询所有 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM interaction
    </select>

    <!-- 根据用户ID查询 -->
    <select id="selectByUserId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM interaction WHERE user_id = #{userId}
    </select>

    <!-- 根据帖子ID查询 -->
    <select id="selectByPostId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM interaction WHERE post_id = #{postId}
    </select>

    <!-- 根据类型查询 -->
    <select id="selectByType" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM interaction WHERE type = #{type}
    </select>

    <!-- 复合条件查询 -->
    <select id="selectByCondition" parameterType="com.agriculture.model.po.Interaction" resultMap="BaseResultMap">
        SELECT * FROM interaction
        <where>
            <if test="postId != null">AND post_id = #{postId}</if>
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="type != null">AND type = #{type}</if>
        </where>
    </select>

    <!-- 检查是否存在 -->
    <select id="exists" parameterType="com.agriculture.model.po.Interaction" resultType="java.lang.Boolean">
        SELECT COUNT(*) > 0 FROM interaction
        WHERE post_id = #{postId} AND user_id = #{userId} AND type = #{type}
    </select>

    <!-- 统计总数 -->
    <select id="count" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM interaction
    </select>

    <!-- 根据条件统计 -->
    <select id="countByCondition" parameterType="com.agriculture.model.po.Interaction" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM interaction
        <where>
            <if test="postId != null">AND post_id = #{postId}</if>
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="type != null">AND type = #{type}</if>
        </where>
    </select>
</mapper>
