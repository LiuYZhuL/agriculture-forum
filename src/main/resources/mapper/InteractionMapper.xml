<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agriculture.dao.InteractionMapper">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.agriculture.model.po.Interaction">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="post_id" property="postId" jdbcType="INTEGER"/>
        <result column="user_id" property="userId" jdbcType="INTEGER"/>
        <result column="type" property="type" jdbcType="TINYINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 插入互动记录 -->
    <insert id="insertInteraction" parameterType="com.agriculture.model.po.Interaction" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO interaction
        <trim prefix="(" suffix=")" suffixOverrides=",">
            post_id, user_id, type,
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{postId}, #{userId}, #{type},
        </trim>
    </insert>

    <!-- 批量插入 -->
    <insert id="batchInsertInteraction">
        INSERT INTO interaction (post_id, user_id, type)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.postId}, #{item.userId}, #{item.type})
        </foreach>
    </insert>


    <!-- 根据ID删除 -->
    <delete id="deleteInteractionById" parameterType="java.lang.Integer" >
        DELETE FROM interaction WHERE id = #{id}
    </delete>
    <!-- 删除帖子的所有互动记录 -->
     <delete id="deletePostInteraction" parameterType="java.lang.Integer">
        DELETE FROM interaction WHERE post_id = #{postId}
    </delete>

    <!-- 根据复合条件删除 -->
    <delete id="deleteInteractionByCondition" parameterType="com.agriculture.model.po.Interaction">
        DELETE FROM interaction
        WHERE post_id = #{postId} AND user_id = #{userId} AND type = #{type}
    </delete>

    <!-- 更新互动记录 -->
    <update id="updateInteraction" parameterType="com.agriculture.model.po.Interaction">
        UPDATE interaction
        <set>
            <if test="postId != null">post_id = #{postId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="type != null">type = #{type},</if>
            create_time =CURRENT_TIMESTAMP <!-- 强制设置为当前时间 -->
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据ID查询 -->
    <select id="selectInteractionById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM interaction WHERE id = #{id}
    </select>

    <!-- 查询所有 -->
    <select id="selectAllInteraction" resultMap="BaseResultMap">
        SELECT * FROM interaction
    </select>

    <!-- 根据用户ID查询 -->
    <select id="selectInteractionByUserId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM interaction WHERE user_id = #{userId}
    </select>

    <!-- 根据帖子ID查询 -->
    <select id="selectInteractionByPostId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM interaction WHERE post_id = #{postId}
    </select>

    <!-- 根据类型查询 -->
    <select id="selectInteractionByType" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT * FROM interaction WHERE type = #{type}
    </select>

    <!-- 复合条件查询 -->
    <select id="selectInteractionByCondition" parameterType="com.agriculture.model.po.Interaction" resultMap="BaseResultMap">
        SELECT * FROM interaction
        <where>
            <if test="postId != null">AND post_id = #{postId}</if>
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="type != null">AND type = #{type}</if>
        </where>
    </select>

    <!-- 检查是否存在 -->
    <select id="existsInteraction" parameterType="com.agriculture.model.po.Interaction" resultType="java.lang.Boolean">
        SELECT COUNT(*) > 0 FROM interaction
        WHERE post_id = #{postId} AND user_id = #{userId} AND type = #{type}
    </select>

    <!-- 统计总数 -->
    <select id="countInteraction" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM interaction
    </select>

    <!-- 根据条件统计 -->
    <select id="countInteractionByCondition" parameterType="com.agriculture.model.po.Interaction" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM interaction
        <where>
            <if test="postId != null">AND post_id = #{postId}</if>
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="type != null">AND type = #{type}</if>
        </where>
    </select>
</mapper>
